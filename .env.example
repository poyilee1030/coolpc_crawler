# 複製這個檔成 .env 後填入你的設定（.env 已被 gitignore，不會進版控）

# ---- Telegram（取代已停用的 LINE Notify）----
# 1. 在 Telegram 找 @BotFather，用 /newbot 建立 bot，取得 token
# 2. 跟你的 bot 傳一則訊息（或把它加進群組）
# 3. 開 https://api.telegram.org/bot<你的token>/getUpdates
#    在回傳的 JSON 裡找到 chat.id，填到 TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 爬蟲設定（都有預設值，可留白）----
# SQLite 資料庫存放目錄（相對路徑會以專案根目錄為基準）
DB_DIR=data
# Chrome 無頭模式 true/false
HEADLESS=true
# Selenium 隱式等待秒數
IMPLICIT_WAIT=5
# 價差超過多少元才通知
PRICE_CHANGE_THRESHOLD=10
# 每隔幾分鐘爬一次；0 = 只跑一次（交給系統排程）
CRAWL_INTERVAL_MINUTES=0
# 要爬的類別 id，逗號分隔；留白則用預設清單
# 例：CATEGORY_IDS=4,12,15
CATEGORY_IDS=
